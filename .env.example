# 复制为 .env 后【必须】修改 DB_PASSWORD，否则程序启动就会报错退出
#
# ⚠️ 密码只能用数字、字母和常见符号：
#    PyMySQL 连接时用 latin1 编码密码，含中文会直接失败
#    （报 UnicodeEncodeError: 'latin-1' codec can't encode characters）
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=改成你的密码
DB_NAME=student_db
DB_PORT=3306

# 想看 SQL 日志就改成 true
DB_ECHO=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 缓存不可用时的超时（秒），本地 0.5 足够
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5